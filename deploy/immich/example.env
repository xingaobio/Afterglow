# Afterglow 版 example.env —— install.sh 会复制成 /opt/immich/.env，并填入随机 DB_PASSWORD。
#
# 基于官方 example.env:
#   https://github.com/immich-app/immich/releases/latest/download/example.env
# 官方文档(各变量含义): https://docs.immich.app/install/docker-compose
#   - UPLOAD_LOCATION 默认 ./library；DB_DATA_LOCATION 默认 ./postgres(不支持网络共享)
#   - TZ 默认注释掉，需要时取消注释；IMMICH_VERSION 示例为 v3
#   - DB_PASSWORD 必须改掉默认值，且只用 A-Za-z0-9
# (本文件同样没能逐行对照官方文件，见 docker-compose.yml 顶部说明；以官方为准。)

# ---- 官方变量 -------------------------------------------------------------------------------

# 上传目录。Afterglow 用外部图库，这里几乎不占空间。
UPLOAD_LOCATION=/data/afterglow/immich/upload

# AFTERGLOW [4]: Postgres 数据目录，放在本地 SSD，不能是网络共享。
DB_DATA_LOCATION=/data/afterglow/immich/postgres

# 时区(取消注释并修改)
TZ=Europe/London

# Immich 版本。官方示例是 v3；想固定到具体版本就写 v3.x.y。
IMMICH_VERSION=v3

# install.sh 生成随机值；只用 A-Za-z0-9。
DB_PASSWORD=CHANGE_ME_installsh_replaces_this

# 以下三项官方默认通常不用改:
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# ---- AFTERGLOW 新增变量 ---------------------------------------------------------------------

# 整理后的目录树 = afterglow.toml 的 paths.organized。容器内挂载为 /mnt/afterglow:ro。
# 在 Immich 里创建外部图库时 import path 填 /mnt/afterglow (afterglow setup 会自动创建)。
AFTERGLOW_ORGANIZED=/data/afterglow/library

# 原始照片根目录 = afterglow.toml 的 paths.source。容器内挂载为 /mnt/source:ro。
PHOTO_SOURCE=/media/photos

# database / valkey 镜像: 由 install.sh 从当前官方 docker-compose.yml 提取并填写在下面。
# 若为空，请打开 /opt/immich/official/docker-compose.yml，把 database 与 redis(valkey) 服务的 image: 行抄过来。
IMMICH_DB_IMAGE=
IMMICH_VALKEY_IMAGE=
