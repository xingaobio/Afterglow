# Afterglow — llama-server，视觉模型 Qwen3-VL-4B (端口 8080)
# 安装: install.sh 会把 @AFTERGLOW_USER@ 替换成当前用户后复制到 /etc/systemd/system/。手动安装见 README.md。
# 标志含义(来源: llama-server 帮助/README，https://huggingface.co/OpenTransformer/llama.cpp-prismml/blob/main/tools/server/README.md
#   以及 https://www.mintlify.com/ggml-org/llama.cpp/api/tools/llama-server):
#   --mmproj FILE  多模态投影文件   -ngl 99  全部层放 GPU   -np 2  两个并行槽(与 [llm].concurrency 对应)
#   -c 8192        上下文总量；多槽时按槽数平分(2 槽 → 每槽约 4096)
#   -fa on         Flash Attention
#   --jinja        使用模型自带的 chat template(--jinja 取自 ARCHITECTURE.md §8；本次未能在文档页逐字核实)
# --alias 必须等于 afterglow.toml 的 [llm].vision_model。
[Unit]
Description=Afterglow llama-server (vision, Qwen3-VL-4B)
After=network.target
Conflicts=afterglow-brain.service

[Service]
Type=simple
User=@AFTERGLOW_USER@
ExecStart=/opt/llama.cpp/build/bin/llama-server \
  -m /data/afterglow/models/gguf/Qwen3VL-4B-Instruct-Q4_K_M.gguf \
  --mmproj /data/afterglow/models/gguf/mmproj-Qwen3VL-4B-Instruct-F16.gguf \
  --alias qwen3-vl-4b \
  -ngl 99 -c 8192 -np 2 -fa on --jinja \
  --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
# 模型加载需要一点时间
TimeoutStartSec=300
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
