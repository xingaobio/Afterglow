# Afterglow — 夜间增量运行(由 afterglow-nightly.timer 触发)
[Unit]
Description=Afterglow nightly incremental run
Wants=afterglow-llm.service
After=afterglow-llm.service network.target

[Service]
Type=oneshot
User=@AFTERGLOW_USER@
ExecStart=/opt/afterglow/.venv/bin/afterglow run
# afterglow 退出码: 0 成功, 2 = 运行中有 failed 文件(不算服务失败), 1/3 = 配置错误/依赖不可用
SuccessExitStatus=2
Nice=10
# 一个 TB 级首次运行可能很多天；增量运行通常几小时。不设上限。
TimeoutStartSec=infinity
